{
  "title": "LTX 2.5 ComfyUI Worker",
  "description": "Run Blackwell-first LTX 2.5 video inference on ComfyUI with persistent /workspace state",
  "type": "serverless",
  "category": "image",
  "iconUrl": "https://cpjrphpz3t5wbwfe.public.blob.vercel-storage.com/comfy-ui.png",
  "config": {
    "runsOn": "GPU",
    "containerDiskInGb": 120,
    "gpuIds": "BLACKWELL_180",
    "gpuCount": 1,
    "allowedCudaVersions": ["13.0", "12.8"],
    "env": [
      {
        "key": "LTX25_PRELOAD_VARIANT",
        "input": {
          "name": "LTX 2.5 Model Profile",
          "type": "string",
          "description": "Startup preload profile: distilled-int8",
          "default": "distilled-int8",
          "advanced": false
        }
      },
      {
        "key": "PERSIST_WORKSPACE",
        "input": {
          "name": "Persist /workspace",
          "type": "boolean",
          "description": "Store ComfyUI, venv, caches, and downloaded assets on the attached network volume",
          "default": true,
          "advanced": false
        }
      },
      {
        "key": "LTX25_PRELOAD_PROMPT_ENHANCER",
        "input": {
          "name": "Preload Prompt Enhancer",
          "type": "boolean",
          "description": "Also preload the Gemma prompt enhancer used by the bundled workflow",
          "default": true,
          "advanced": true
        }
      },
      {
        "key": "HUGGINGFACE_ACCESS_TOKEN",
        "input": {
          "name": "Hugging Face Token",
          "type": "string",
          "description": "Read token with accepted access to the gated LTX 2.5 model",
          "default": "",
          "advanced": true
        }
      },
      {
        "key": "AWS_BUCKET_NAME",
        "input": {
          "name": "S3 Bucket Name",
          "type": "string",
          "description": "Optional AWS S3 bucket for generated artifacts",
          "default": "",
          "advanced": true
        }
      },
      {
        "key": "AWS_ACCESS_KEY_ID",
        "input": {
          "name": "S3 Access Key ID",
          "type": "string",
          "description": "AWS Access Key ID (if S3 upload is enabled)",
          "default": "",
          "advanced": true
        }
      },
      {
        "key": "AWS_SECRET_ACCESS_KEY",
        "input": {
          "name": "S3 Secret Access Key",
          "type": "string",
          "description": "AWS Secret Access Key (if S3 upload is enabled)",
          "default": "",
          "advanced": true
        }
      },
      {
        "key": "AWS_DEFAULT_REGION",
        "input": {
          "name": "S3 Region",
          "type": "string",
          "description": "AWS region for optional S3 artifact uploads",
          "default": "us-east-1",
          "advanced": true
        }
      },
      {
        "key": "COMFY_LOG_LEVEL",
        "input": {
          "name": "ComfyUI Log Level",
          "type": "string",
          "description": "Log level for ComfyUI (DEBUG, INFO, WARNING, ERROR, CRITICAL)",
          "default": "DEBUG",
          "advanced": true
        }
      },
      {
        "key": "RUN_MODE",
        "input": {
          "name": "Runtime Mode",
          "type": "string",
          "description": "Use worker for RunPod Serverless",
          "default": "worker",
          "advanced": false
        }
      }
    ]
  }
}
